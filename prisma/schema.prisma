generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Seller {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price_cents Int
  seller      Seller   @relation(fields: [sellerId], references: [id])
  sellerId    Int
  createdAt   DateTime @default(now())
}
