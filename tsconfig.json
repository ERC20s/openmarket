{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "ES2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  // tests/ is excluded because `next build` type-checks everything in "include",
  // and the vitest mocks assign res.body, which is not a field on NextApiResponse.
  // vitest transpiles without type-checking, so the tests themselves still run.
  "exclude": ["node_modules", ".next", "tests"]
}
